# Required in production. Any long random string: openssl rand -base64 32
AUTH_SECRET=

# Neon Postgres (accounts, PRs, social). Added by the Neon integration in Vercel.
DATABASE_URL=

# Vercel Blob (each user's private training log). Added when you create a Blob store.
BLOB_READ_WRITE_TOKEN=

# USDA FoodData Central key (free: https://api.data.gov/signup). Server-only, never exposed to the browser.
# Without it the shared, heavily rate-limited DEMO_KEY is used.
USDA_API_KEY=
