# Required in production. Any long random string: openssl rand -base64 32
AUTH_SECRET=

# Storage. Create a free Redis database from the Upstash integration in the
# Vercel Marketplace and these are filled in for you. Without them the app
# keeps data in server memory, which is wiped on every serverless cold start.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Older Vercel KV names also work:
# KV_REST_API_URL=
# KV_REST_API_TOKEN=
